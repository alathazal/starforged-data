{
    "$schema": "https://json-schema.org/draft/2020-12/schema",

    "$defs": {
        "Truth": {
            "type": "object",
            "properties": {
                "name": {
                    "description": "The name of the truth.",
                    "type": "string"
                },
                "icon": {
                    "description": "The icon for the truth.",
                    "type": "string"
                },
                "table": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/TruthTableEntry"
                    }
                },
                "character": {
                    "description": "The character prompt for the truth.",
                    "type": "string"
                },
                "source": {
                    "type": "object",
                    "$ref": "schema:///shared.schema.json#/$defs/Source"
                }
            },
            "required": [ "name", "icon", "table", "source" ]
        },

        "TruthSubtableEntry": {
            "type": "object",
            "properties": {
                "floor": {
                    "description": "The floor value of the table entry.",
                    "type": "integer"
                },
                "ceiling": {
                    "description": "The ceiling value of the table entry.",
                    "type": "integer"
                },
                "result": {
                    "description": "The result of the table entry.",
                    "type": "string"
                }
            },
            "required": [ "floor", "ceiling", "result" ]
        },

        "TruthTableEntry": {
            "type": "object",
            "properties": {
                "floor": {
                    "description": "The floor value of the table entry.",
                    "type": "integer"
                },
                "ceiling": {
                    "description": "The ceiling value of the table entry.",
                    "type": "integer"
                },
                "result": {
                    "description": "The result of the table entry.",
                    "type": "string"
                },
                "description": {
                    "description": "The description of the table entry.",
                    "type": "string"
                },
                "subtable": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/TruthSubtableEntry"
                    }
                },
                "queststarter": {
                    "description": "The quest starter suggestion for the table entry.",
                    "type": "string"
                }
            },
            "required": [ "floor", "ceiling", "result" ]
        }
    },

    "title": "Truths",

    "description": "Data structure representing Truths (Rulebook 84-98).",

    "type": "array",

    "items": {
        "$ref": "#/$defs/Truth"
    }
}
