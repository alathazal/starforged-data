{
    "$schema": "https://json-schema.org/draft/2020-12/schema",

    "$id": "shared.schema.json",

    "$defs": {
        "Source": {
            "type": "object",
            "properties": {
                "title": {
                    "description": "The title of the source.",
                    "type": "string",
                    "enum": [
                        "Ironsworn: Starforged Reference Guide",
                        "Ironsworn: Starforged Rulebook"
                    ]
                },
                "authors": {
                    "description": "The authors of the source.",
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "date": {
                    "description": "The publication date of the source.",
                    "type": "string"
                },
                "page": {
                    "description": "The page number of the source.",
                    "type": "string"
                }
            },
            "required": [ "title", "authors", "date", "page" ]
        }
    }
}